
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Ana Beatriz Lazo - Contacto</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue",
                         Arial, sans-serif;
            background:
                radial-gradient(circle at top left, #292929 0%, transparent 45%),
                #0d0d0d;
            color: #ffffff;
        }

        .card {
            width: calc(100% - 40px);
            max-width: 390px;
            padding: 45px 30px 35px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 24px;
            box-shadow: 0 25px 70px rgba(0, 0, 0, 0.45);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            text-align: center;
        }

        .name {
            font-size: 28px;
            font-weight: 700;
            letter-spacing: -0.5px;
            margin-bottom: 30px;
        }

        .contact-info {
            margin-bottom: 30px;
        }

        .contact-info a {
            display: block;
            color: #ffffff;
            text-decoration: none;
            font-size: 15px;
            line-height: 1.5;
            margin: 12px 0;
        }

        .contact-info a:hover {
            text-decoration: underline;
        }

        .links {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .links a {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 54px;
            padding: 15px 20px;
            border: 1px solid rgba(255, 255, 255, 0.16);
            border-radius: 12px;
            color: #ffffff;
            text-decoration: none;
            font-size: 15px;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .links a:hover {
            background: rgba(255, 255, 255, 0.08);
            transform: translateY(-2px);
        }

        .save {
            margin-top: 8px;
            background: #ffffff !important;
            color: #111111 !important;
            border-color: #ffffff !important;
            font-weight: 700 !important;
        }

        .save:hover {
            background: #e9e9e9 !important;
        }

        .icon {
            margin-right: 10px;
            font-size: 18px;
        }

        .footer {
            margin-top: 32px;
            font-size: 11px;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #666666;
        }
    </style>
</head>

<body>

    <main class="card">

        <div class="name">
            Ana Beatriz Lazo
        </div>

        <div class="contact-info">

            <a href="tel:+525551828566">
                +52 55 5182 8566
            </a>

            <a href="mailto:ablazo@elfaro.net">
                ablazo@elfaro.net
            </a>

        </div>

        <div class="links">

            <a href="tel:+525551828566">
                <span class="icon">☎</span>
                Llamar
            </a>

            <a href="mailto:ablazo@elfaro.net">
                <span class="icon">✉</span>
                Enviar correo
            </a>

            <a class="save" href="contact.vcf" download>
                <span class="icon">＋</span>
                Agregar contacto
            </a>

        </div>

        <div class="footer">
            Digital Contact Card
        </div>

    </main>

</body>
</html>
